  {"id": "menu_lluvia", "text": "¡Vamos a alegrar a Gruñi!"},
  {"id": "llu_nuevo_mundo", "text": "¡Se abrió un mundo nuevo!"},
  {"id": "llu_m1_intro", "text": "Gruñi está triste. ¿Lo ayudamos a sonreír?"},
  {"id": "llu_regalo", "text": "¡Toca un regalo o llévalo hasta Gruñi!"},
  {"id": "llu_m1_dos", "text": "¡Oh, hay dos nubes tristes! ¿Alegramos a las dos?"},
  {"id": "llu_otra_nube", "text": "¡Muy bien! ¡Ahora la otra nube!"},
  {"id": "llu_anima_regalo", "text": "¡Dale un regalo a Gruñi!"},
  {"id": "llu_m1_fin", "text": "¡Salió el arcoíris! ¡Gruñi está feliz!"},
  {"id": "llu_m1_fin2", "text": "¡Salió el arcoíris! ¡Las dos nubes están felices!"},
  {"id": "llu_m2_intro", "text": "¡Es la hora de la merienda! ¿Qué le damos a Gruñi?"},
  {"id": "llu_m2_plato", "text": "¡Armemos un plato con tres cosas ricas para Gruñi!"},
  {"id": "llu_m2_picnic", "text": "¡Vamos de picnic con los amigos! Cada uno quiere algo."},
  {"id": "llu_anima_comida", "text": "¿Qué le damos a Gruñi?"},
  {"id": "llu_pic_rex", "text": "¡Rex quiere algo verde!"},
  {"id": "llu_pic_maxi", "text": "¡Maxi quiere algo rojo!"},
  {"id": "llu_pic_bip", "text": "¡Bip quiere algo amarillo!"},
  {"id": "llu_pic_gruni", "text": "¡Gruñi quiere algo morado!"},
  {"id": "llu_picno_rex", "text": "Mmm, eso no es verde. ¡Rex quiere algo verde!"},
  {"id": "llu_picno_maxi", "text": "Mmm, eso no es rojo. ¡Maxi quiere algo rojo!"},
  {"id": "llu_picno_bip", "text": "Mmm, eso no es amarillo. ¡Bip quiere algo amarillo!"},
  {"id": "llu_picno_gruni", "text": "Mmm, eso no es morado. ¡Gruñi quiere algo morado!"},
  {"id": "llu_picsi_rex", "text": "¡Sí! ¡El brócoli es verde! ¡Rex está feliz!"},
  {"id": "llu_picsi_maxi", "text": "¡Sí! ¡La manzana es roja! ¡Maxi está feliz!"},
  {"id": "llu_picsi_bip", "text": "¡Sí! ¡El plátano es amarillo! ¡Bip está feliz!"},
  {"id": "llu_picsi_gruni", "text": "¡Sí! ¡Las uvas son moradas! ¡Gruñi está feliz!"},
  {"id": "llu_m3_manana", "text": "¡Buenos días! Gruñi se está despertando. ¿Lo ayudamos?"},
  {"id": "llu_m3_tarde", "text": "¡Qué linda tarde! ¿Qué quiere hacer Gruñi?"},
  {"id": "llu_m3_noche", "text": "Ya es de noche. Gruñi se prepara para dormir."},
  {"id": "llu_m3_f_manana", "text": "¡Salió el sol! ¡Gruñi está listo para el día!"},
  {"id": "llu_m3_f_tarde", "text": "¡Muy bien! Gruñi jugó, tomó agua y comió fruta."},
  {"id": "llu_lampara", "text": "Ahora, apaga la lámpara."},
  {"id": "llu_m3_fin", "text": "Buenas noches, Gruñi. Que tengas lindos sueños."},
  {"id": "menu_memoria", "text": "¡Vamos a jugar a la memoria con Rex!"},
  {"id": "mem_intro", "text": "¡Busca las cartas iguales!"},
